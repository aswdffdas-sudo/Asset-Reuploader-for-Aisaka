    local instance = buttonAsset:Clone()
    instance.Text = text

    local self: Label = {
        instance = instance,

        ChangeText = ChangeText,
        UpdateTheme = UpdateTheme,
        Destroy = Destroy,
    }

    self:UpdateTheme()
    instance.Parent = parent

    return self
end

return Label
